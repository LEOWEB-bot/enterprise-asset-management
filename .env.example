# ==============================================================================
# Enterprise Asset Management (EAM) - Environment Variables Template
# Salin file ini menjadi .env atau .env.local untuk konfigurasi lokal/produksi.
# JANGAN PERNAH MENYIMPAN ATAU MENG-COMMIT NILAI RAHASIA / API KEY ASLI KE GITHUB!
# ==============================================================================

# Mode Lingkungan (development | production | staging)
VITE_APP_ENV=production

# Mode Fresh Install (atur 'true' saat deploy awal ke VPS agar Setup Wizard menyapa Admin)
VITE_FRESH_INSTALL=true

# Nama Aplikasi / Instansi Resmi
VITE_APP_NAME="Enterprise Asset Management"

# URL Publik Aplikasi / Domain Produksi Resmi
VITE_APP_DOMAIN="https://eam.instansi-anda.com"

# Prefix Bawaan Penomoran Kode Aset Otomatis
VITE_DEFAULT_CODE_PREFIX="AST-"

# Durasi Masa Tenggang Sesi Login (Menit)
VITE_SECURITY_SESSION_TIMEOUT=30

# Aktifkan Pencatatan Audit Trail
VITE_ENABLE_AUDIT_LOG=true

# Port Server Pengembangan Frontend Vite (npm run dev)
VITE_DEV_PORT=5173

# Port Backend API Terpusat (Node.js Express)
VITE_BACKEND_PORT=3001

# Port Pemetaan Kontainer Produksi (Docker Compose)
VITE_DOCKER_PORT=8080

# ==============================================================================
# Konfigurasi Pencadangan Otomatis (Backup & Disaster Recovery)
# ==============================================================================

# Jumlah riwayat cadangan lokal yang dipertahankan di data/backups/
BACKUP_RETENTION_COUNT=15

# Interval pencadangan otomatis internal (Jam)
BACKUP_INTERVAL_HOURS=24

# Pencadangan Otomatis Cloud (Kompatibel S3: AWS S3, Cloudflare R2, MinIO, Wasabi)
BACKUP_CLOUD_ENABLED=false
BACKUP_CLOUD_PROVIDER=s3
BACKUP_CLOUD_ENDPOINT=""
BACKUP_CLOUD_BUCKET=""
BACKUP_CLOUD_ACCESS_KEY=""
BACKUP_CLOUD_SECRET_KEY=""
BACKUP_CLOUD_REGION="auto"
